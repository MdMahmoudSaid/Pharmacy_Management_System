{
  "name": "pharmacy-system",
  "version": "1.0.0",
  "description": "Bilingual pharmacy management PWA",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "generate:icons": "node --import tsx scripts/generate-icons.ts",
    "prebuild": "pnpm generate:icons",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "create-admin": "node --import tsx scripts/create-admin.ts",
    "check": "pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm build"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.34.6",
  "dependencies": {
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@node-rs/argon2": "^2.2.2",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.54.0",
    "next": "^16.4.0",
    "next-intl": "4.14.7",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "jsdom": "^30.1.2",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
